{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi",
  "version": "0.1.0",
  "identifier": "com.reqox.lexi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lexi",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Education",
    "shortDescription": "Personal English learning app",
    "longDescription": "A local-first flashcard app for learning English."
  }
}
